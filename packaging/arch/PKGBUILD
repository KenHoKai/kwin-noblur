prepare() {
  local source_root="$srcdir/kwin-$pkgver"
  local metadata="$source_root/src/plugins/overview/metadata.json"

  patch -d "$source_root" -Np1 -i "$srcdir/kwin-noblur.patch"

  [[ -f "$metadata" ]] || {
    echo "Overview metadata not found."
    return 1
  }

  python - "$metadata" <<'PYMETA'
import json
import sys
from pathlib import Path

metadata = Path(sys.argv[1])
data = json.loads(metadata.read_text())
plugin = data["KPlugin"]

keys = [k for k in plugin if k == "Name" or k.startswith("Name[")]
if "Name" not in keys:
    raise SystemExit("Effect metadata name not found.")

for key in keys:
    plugin[key] = "Konveyor NoBlur"

metadata.write_text(json.dumps(data, ensure_ascii=False, indent=4))
print("Effect display name set to Konveyor NoBlur.")
PYMETA
}

build() {
  cmake -B build  -S "kwin-$pkgver" \
    -DKDE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build --parallel 2
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
